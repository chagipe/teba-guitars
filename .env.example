# ============================================
# Teba Guitars — Variables de entorno
# Copia este archivo como .env y completa los valores
# ============================================

# --- Email (opcional) ---
# Servicio de email: 'formspree' | 'emailjs' | dejar vacío para solo WhatsApp
VITE_EMAIL_SERVICE=

# Formspree
VITE_FORMSPREE_ENDPOINT=

# EmailJS
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Google Places API (opcional, para reseñas automáticas) ---
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=

# --- Analítica (opcional) ---
# 'plausible' | 'umami' | dejar vacío para desactivar
VITE_ANALYTICS_PROVIDER=
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SCRIPT_URL=

# --- Cal.com (opcional, para reservas) ---
VITE_CALCOM_URL=
